{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "dentro-da-ansiedade-miguelrsants-projects.vercel.app" }], "destination": "https://dentro-da-ansiedade.vercel.app/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "dentro-da-ansiedade-git-main-miguelrsants-projects.vercel.app" }], "destination": "https://dentro-da-ansiedade.vercel.app/:path*", "permanent": true },
    { "source": "/about", "destination": "/sobre", "permanent": true },
    { "source": "/contact", "destination": "/contato", "permanent": true },
    { "source": "/privacy", "destination": "/privacidade", "permanent": true }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Link", "value": "</llms.txt>; rel=\"describedby\"; type=\"text/markdown\", </index.md>; rel=\"alternate\"; type=\"text/markdown\", </sitemap.xml>; rel=\"sitemap\"" }, { "key": "Vary", "value": "Accept" }] },
    { "source": "/(.*).md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }, { "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/llms.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
